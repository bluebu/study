# 构建产物一律不进库（由 GitHub Actions 在部署时生成）
dist/

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# 本地素材（作业照片 / 录音，不上传）
inbox/

# 喂数据台（../feeder）的中间产物，都不进 git：
#   *.marked.png   核对图，看一眼框对不对就没用了
#   *.page.json    整页 OCR + 每行每词的坐标，85 KB 一份。真正的输入是
#   *.cards.json   人核对定稿的那份，这些只是它的来路
#   *.board.json
#   *.draft.*      机器出的候选（词表 CSV、复述关键词、拼音）。
#                  **人核对完另存成正式文件名**再进 git —— 没核过的不许混进来
# 数据本身（.read.json / .ref.txt / .json / .words.tsv）要进 git ——
# 录音和教材照片不进仓库，那些测量再也算不出来。
*.marked.png
*.page.json
*.cards.json
*.board.json
*.draft.*
