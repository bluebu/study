# 构建产物一律不进库（由 GitHub Actions 在部署时生成）
dist/

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# 本地素材（作业照片 / 录音，不上传）
inbox/

# 喂数据台（../feeder）的过程产物和候选，都不进 git：
#   *.marked.png / *.page.json / *.cards.json / *.board.json / *.full.txt
#       核对用的临时产物，看一眼框对不对就没用了，从素材随时能再算一遍
#   *.draft.*
#       机器出的候选。**人核对完另存成正式文件名**再进 git —— 没核过的不许混进来
#
# 哪些要 push、哪些是临时的，四档去向见 **DATA.md** —— 那张表是唯一真源，
# 别在这儿维护第二份说明。
*.marked.png
*.page.json
*.cards.json
*.board.json
*.full.txt
*.draft.*
